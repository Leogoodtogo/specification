{
  "name": "my-pdf",
  "installCommand": "",
  "buildCommand": "",
  "assets": {
    "directory": "./"
  },
  "headers": [
    {
      "source": "/*.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    },
    {
      "source": "/images/*/*.jpg",
      "headers": [
        { "key": "Content-Type", "value": "image/jpeg" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
